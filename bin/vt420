#!/usr/bin/env bash
# vt420 from this checkout; symlinks into PATH resolve back here
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# the node the install built node-pty for
node="$(cat "$ROOT/node_modules/.vt420-node" 2>/dev/null || echo node)"
exec "$node" --conditions=source --disable-warning=ExperimentalWarning "$ROOT/src/emulator.ts" "$@"
